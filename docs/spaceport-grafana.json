    {
      "id": 35,
      "type": "table",
      "title": "Registered",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_ACCOUNTS}"
      },
      "gridPos": {
        "x": 0,
        "y": 85,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_ACCOUNTS}"
          },
          "format": "table",
          "rawSql": "SELECT realname AS name, CASE WHEN regdate > 1000000000000 THEN FROM_UNIXTIME(regdate / 1000) WHEN regdate > 0 THEN FROM_UNIXTIME(regdate) ELSE NULL END AS registered, regip AS registered_from FROM authme ORDER BY regdate DESC LIMIT 20",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 36,
      "type": "table",
      "title": "Addresses shared by more than one account",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_ACCOUNTS}"
      },
      "gridPos": {
        "x": 12,
        "y": 85,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_ACCOUNTS}"
          },
          "format": "table",
          "rawSql": "SELECT address, COUNT(*) AS accounts, GROUP_CONCAT(name ORDER BY name SEPARATOR ', ') AS names FROM spaceport_address GROUP BY address HAVING COUNT(*) > 1 ORDER BY accounts DESC LIMIT 30",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 37,
      "type": "table",
      "title": "This account",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_ACCOUNTS}"
      },
      "gridPos": {
        "x": 0,
        "y": 93,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_ACCOUNTS}"
          },
          "format": "table",
          "rawSql": "SELECT a.realname AS name, CASE WHEN a.regdate > 1000000000000 THEN FROM_UNIXTIME(a.regdate / 1000) WHEN a.regdate > 0 THEN FROM_UNIXTIME(a.regdate) ELSE NULL END AS registered, a.regip AS registered_from, CASE WHEN a.lastlogin > 1000000000000 THEN FROM_UNIXTIME(a.lastlogin / 1000) WHEN a.lastlogin > 0 THEN FROM_UNIXTIME(a.lastlogin) ELSE NULL END AS last_login, a.ip AS last_address, CASE WHEN p.name IS NULL THEN 'no' ELSE 'yes' END AS premium, CASE WHEN t.name IS NULL THEN 'no' ELSE 'yes' END AS staff_second_factor FROM authme a LEFT JOIN spaceport_premium p ON p.name = a.realname LEFT JOIN spaceport_totp t ON t.name = a.realname WHERE a.realname = ${player:sqlstring} OR a.username = LOWER(${player:sqlstring}) LIMIT 5",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 38,
      "type": "table",
      "title": "Address history",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_ACCOUNTS}"
      },
      "gridPos": {
        "x": 0,
