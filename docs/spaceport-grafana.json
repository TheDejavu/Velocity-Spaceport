          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(spaceport_ready, job)",
          "refId": "job"
        },
        "definition": "label_values(spaceport_ready, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
