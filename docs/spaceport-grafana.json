            "uid": "${DS_ACCOUNTS}"
          },
          "format": "table",
          "rawSql": "SELECT other.name AS account, other.address, other.first_seen, other.last_seen FROM spaceport_address mine JOIN spaceport_address other ON other.address = mine.address AND other.name <> mine.name WHERE mine.name = ${player:sqlstring} ORDER BY other.last_seen DESC LIMIT 30",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
