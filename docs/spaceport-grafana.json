            "type": "mysql",
            "uid": "${DS_ACCOUNTS}"
          },
          "format": "table",
          "rawSql": "SELECT address, first_seen, last_seen FROM spaceport_address WHERE name = ${player:sqlstring} ORDER BY last_seen DESC LIMIT 20",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
